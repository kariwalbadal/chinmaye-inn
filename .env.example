# Chinmaye Hotels — booking engine secrets
# Copy to .env, fill in, then run: node scripts/build-booking-config.mjs
# .env is gitignored; only the generated js/booking-config.js is deployed.

# Paste each property's booking-engine link from the STAAH dashboard.
# Optional placeholders {checkin} {checkout} {adults} are substituted
# with the guest's selections (dates as YYYY-MM-DD).
# Example (Inn live engine): https://booking.chinmaye.in/inst/#/home?propertyId=323MjQtbChGGuyBeGdF7Z75Mjk=&JDRN=Y&RoomID=142868,142869,142870,142871,142872&gsId=323MjQtbChGGuyBeGdF7Z75Mjk=

STAAH_INN_ENABLED=false
STAAH_INN_URL=

STAAH_GRAND_ENABLED=false
STAAH_GRAND_URL=

STAAH_DEOGHAR_ENABLED=false
STAAH_DEOGHAR_URL=

# Careers form relay (FormSubmit.co) — free, sends the application + CV to info@chinmaye.in.
# Setup: submit the careers form once against https://formsubmit.co/info@chinmaye.in,
# click the activation link in that inbox, then paste the random token endpoint here.
# Public value (a post-only endpoint id), not a secret. Empty = form falls back to WhatsApp.
CAREERS_FORM_ENDPOINT=
